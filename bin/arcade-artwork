#!/usr/bin/env python3
"""Fetch arcade artwork for the arcade panel, one picture per ROM.

Title screens, in-game snaps and box art come from libretro's thumbnail
server (https://thumbnails.libretro.com). Marquees and flyers come from the
Arcade Database by motoschifo (https://adb.arcadeitalia.net), which asks that
the source be cited and that a machine use one connection at a time -- so
those are fetched one after another while the rest run in parallel.

Game names and artwork belong to their respective owners.

The overlay calls this with the ROM names it is about to show. Every name that
already has a cached image is printed straight back; the rest are downloaded in
the background and printed as they land, so tiles fill in while you look at
them.

    arcade-artwork bublbobl gng snowbro2
    bublbobl<TAB>/home/you/.cache/omarchy/arcade-art/bublbobl.png
    gng<TAB>/home/you/.cache/omarchy/arcade-art/gng.png
    snowbro2<TAB>

An empty second field means there is no artwork for that game: a miss is
recorded so the next open does not ask the network again (--refresh forgets
them). Stdout is flushed per line; nothing here ever blocks the caller.
"""

import argparse
import os
import re
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed

BASE_URL = "https://thumbnails.libretro.com"

# Systems to look in, in order. A FBNeo romset and a MAME romset use the same
# short names, so the first system that has the title wins.
SYSTEMS = (
    "FBNeo - Arcade Games",
    "MAME",
    "MAME 2003-Plus",
)

# Title screens first: the game's own logo, framed the same way every time, and
# legible at tile size. An in-game snap is the fallback, then whatever boxart
# exists -- many arcade titles never had a box.
LIBRETRO_KINDS = {
    "titles": "Named_Titles",
    "snaps": "Named_Snaps",
    "boxarts": "Named_Boxarts",
}

# The Arcade Database files its pictures under the ROM name, which is what
# the arcade calls a game anyway: the lit sign above the screen, and the
# operator's advertising poster.
ADB_URL = "https://adb.arcadeitalia.net/media/mame.current"
# "It is strongly recommended to use a single connection per ip address at a
# time" -- the Arcade Database's own word on scraping it.
ADB_LOCK = threading.Lock()
ADB_KINDS = {
    "marquees": "marquees",
    "flyers": "flyers",
}

KINDS = dict(LIBRETRO_KINDS, **ADB_KINDS)
DEFAULT_KINDS = ("titles", "snaps", "boxarts")

TIMEOUT = 15
USER_AGENT = "omarchy-arcade/1.8 (+https://github.com/kimm-stensborg/omarchy-arcade)"

# libretro replaces these characters in thumbnail filenames.
ILLEGAL = re.compile(r"[&*/:`<>?\\|\"]")


def cache_home():
    return os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")


def config_path():
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.environ.get("ARCADE_CONFIG") or os.path.join(config_home, "omarchy", "arcade.conf")


def read_config():
    """The few keys this script cares about, read out of arcade.conf.

    The file is a shell fragment, so only plain KEY=value lines are understood
    -- which is all the launcher writes there. Keeping the artwork policy in
    the config rather than in the panel means one place turns it off.
    """
    values = {}
    try:
        with open(config_path(), "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                key = key.strip()
                if key in ("ARTWORK", "ART_KINDS", "ART_DIR"):
                    values[key] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def games_dir():
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.environ.get("ARCADE_GAMES_DIR") or os.path.join(config_home, "omarchy", "arcade-games")


def game_art(rom):
    """The artwork a game asked for in its own settings: a kind, "custom"
    for a picture of your own, or "" to follow ART_KINDS."""
    try:
        with open(os.path.join(games_dir(), rom + ".cfg"), "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                key, sep, value = line.partition("=")
                if sep and key.strip() == "arcade_art":
                    return value.strip().strip('"')
    except OSError:
        pass
    return ""


def kinds_for(rom, kinds, exact=False):
    """A game's own choice first, then the usual order to fall back on."""
    if exact:
        return list(kinds)
    wanted = game_art(rom)
    if wanted in KINDS:
        return [wanted] + [k for k in kinds if k != wanted]
    return kinds


def artwork_disabled(value):
    return str(value).strip().lower() in ("off", "no", "0", "false", "none")


def load_titles(path):
    """rom -> full database title, from the cache arcade-launcher builds."""
    titles = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                # rom, title, then year and maker, which are not needed here.
                fields = line.rstrip("\n").split("\t")
                if len(fields) >= 2 and fields[0] and fields[1]:
                    titles.setdefault(fields[0], fields[1])
    except OSError:
        pass
    return titles


def load_gameinfo_titles(titles):
    """FinalBurn Neo's own names, for the games the libretro database does not
    name -- the panel lists games you do not have, and their title screens are
    filed under these names too. The table ships beside this script."""
    here = os.path.dirname(os.path.realpath(__file__))
    path = os.path.join(os.path.dirname(here), "share", "arcade-gameinfo.tsv")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("#"):
                    continue
                fields = line.rstrip("\n").split("\t")
                if len(fields) >= 6 and fields[0] and fields[5]:
                    titles.setdefault(fields[0], fields[5])
    except OSError:
        pass
    return titles


def thumbnail_urls(rom, title, kinds):
    """(kind, where it lives) for each kind of picture, in the order asked for."""
    for kind in kinds:
        if kind in ADB_KINDS:
            yield kind, "%s/%s/%s.png" % (ADB_URL, ADB_KINDS[kind], urllib.parse.quote(rom))
            continue
        if not title:
            continue
        name = urllib.parse.quote(ILLEGAL.sub("_", title) + ".png")
        for system in SYSTEMS:
            yield kind, "%s/%s/%s/%s" % (BASE_URL, urllib.parse.quote(system), LIBRETRO_KINDS[kind], name)


def download(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    # One at a time from the Arcade Database, as it asks.
    lock = ADB_LOCK if url.startswith(ADB_URL) else None
    if lock:
        lock.acquire()
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            if response.status != 200:
                return None
            data = response.read()
    finally:
        if lock:
            lock.release()
    # A PNG or nothing: an HTML error page saved as .png would render as a
    # broken tile forever.
    return data if data[:8] == b"\x89PNG\r\n\x1a\n" else None


def kind_of(art_dir, rom):
    """Which kind the cached picture is, as written beside it."""
    try:
        with open(os.path.join(art_dir, rom + ".kind"), "r", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def remember_kind(art_dir, rom, kind):
    try:
        with open(os.path.join(art_dir, rom + ".kind"), "w", encoding="utf-8") as fh:
            fh.write(kind + "\n")
    except OSError:
        pass


def art_path(art_dir, rom, kind, exact):
    """Where a picture is kept. A preview of one exact kind keeps its own file,
    so flicking between kinds shows each one at once."""
    return os.path.join(art_dir, rom + ("." + kind if exact else "") + ".png")


def fetch_one(rom, title, art_dir, kinds, unreachable=None, exact=False):
    """Returns the path to this ROM's artwork, or "" when there is none."""
    kinds_wanted = kinds_for(rom, kinds, exact)
    target = art_path(art_dir, rom, kinds_wanted[0], exact)
    cached = os.path.isfile(target) and os.path.getsize(target) > 0

    miss = target[: -len(".png")] + ".miss"
    # A picture of your own that has gone missing is not fetched over.
    # A picture already here stays unless another kind is asked for now.
    if cached and (exact or game_art(rom) == "custom" or kind_of(art_dir, rom) in ("", kinds_wanted[0])):
        return target

    # A game the databases do not name can still have a picture filed under
    # its ROM name.
    if os.path.exists(miss) or (game_art(rom) == "custom" and not exact):
        return ""
    if not title and not [k for k in kinds_wanted if k in ADB_KINDS]:
        return ""
    kinds = kinds_wanted

    # Whether the server ever actually answered, and whether anything went
    # unanswered. Only a 404 on every URL is a miss: a machine that is offline,
    # a timeout or a 5xx says nothing about the artwork, and remembering it as
    # a miss would leave the tile blank long after the network came back.
    answered = False
    unsure = False
    noted = False

    for kind, url in thumbnail_urls(rom, title, kinds):
        url_kind = kind
        try:
            data = download(url)
        except urllib.error.HTTPError as err:
            if err.code == 404:
                answered = True  # it replied, it just does not have this one
            else:
                unsure = True  # busy or broken right now; ask again later
            continue
        except (urllib.error.URLError, OSError) as err:
            # No network, DNS, timeout: nothing was learned. Worth one line in
            # the caller's report, once per game rather than once per URL.
            unsure = True
            if unreachable is not None and not noted:
                unreachable.append("%s (%s)" % (rom, err))
                noted = True
            continue
        except ValueError:
            answered = True  # a URL built wrongly; retrying will not help
            continue
        answered = True
        if not data:
            continue

        tmp = target + ".part"
        try:
            with open(tmp, "wb") as fh:
                fh.write(data)
            os.replace(tmp, target)
            if not exact:
                remember_kind(art_dir, rom, url_kind)
        except OSError:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            return ""
        return target

    # Remember the miss, so a game the server simply does not have costs one
    # round of requests rather than one per open. Only when the server answered:
    # recording a miss while offline would mark the whole library as artless
    # until someone ran --refresh on every game by hand.
    if answered and not unsure:
        try:
            open(miss, "a").close()
        except OSError:
            pass
    return ""


def main(argv):
    parser = argparse.ArgumentParser(
        prog="arcade-artwork",
        description="Fetch arcade artwork from libretro's thumbnail server",
    )
    parser.add_argument("roms", nargs="*", help="ROM names, without the extension")
    parser.add_argument("--dir", default=os.path.join(cache_home(), "omarchy", "arcade-art"),
                        help="where the images are cached")
    parser.add_argument("--titles", default=os.path.join(cache_home(), "omarchy", "arcade-titles.cache.tsv"),
                        help="rom<TAB>title cache to resolve names with")
    parser.add_argument("--kinds", default=",".join(DEFAULT_KINDS),
                        help="artwork kinds to try, in order (%s)" % ",".join(KINDS))
    parser.add_argument("--kind", default="",
                        help="exactly this kind, whatever the game itself asks for: for a preview")
    parser.add_argument("--offline", action="store_true",
                        help="only report what is already cached")
    parser.add_argument("--refresh", action="store_true",
                        help="forget recorded misses and try them again")
    parser.add_argument("--jobs", type=int, default=4, help="parallel downloads")
    args = parser.parse_args(argv[1:])

    config = read_config()

    # ARTWORK=off in arcade.conf means never reach for the network; whatever is
    # already cached is still reported, so turning it off does not blank tiles
    # that are already there.
    offline = args.offline or artwork_disabled(config.get("ARTWORK", "on"))

    exact = bool(args.kind)
    kind_source = args.kind if exact else (
        args.kinds if args.kinds != ",".join(DEFAULT_KINDS) else config.get("ART_KINDS", args.kinds))
    kinds = [k.strip() for k in kind_source.replace(",", " ").split() if k.strip() in KINDS]
    if not kinds:
        kinds = list(DEFAULT_KINDS)

    if config.get("ART_DIR") and args.dir == os.path.join(cache_home(), "omarchy", "arcade-art"):
        args.dir = os.path.expanduser(os.path.expandvars(config["ART_DIR"]))

    try:
        os.makedirs(args.dir, exist_ok=True)
    except OSError as err:
        print("arcade-artwork: cannot use %s (%s)" % (args.dir, err), file=sys.stderr)
        return 1

    roms = args.roms or [line.strip() for line in sys.stdin if line.strip()]
    if not roms:
        return 0

    if args.refresh:
        for rom in roms:
            try:
                os.unlink(os.path.join(args.dir, rom + ".miss"))
            except OSError:
                pass

    titles = load_gameinfo_titles(load_titles(args.titles))

    # Cached images are reported first and without touching the network, so the
    # grid is already dressed before a single request goes out.
    pending = []
    for rom in roms:
        wanted = kinds_for(rom, kinds, exact)[0]
        path = art_path(args.dir, rom, wanted, exact)
        fresh = exact or kind_of(args.dir, rom) in ("", wanted) or game_art(rom) == "custom"
        if os.path.isfile(path) and os.path.getsize(path) > 0 and (fresh or offline):
            print("%s\t%s" % (rom, path), flush=True)
        elif offline:
            print("%s\t" % rom, flush=True)
        else:
            pending.append(rom)

    if not pending:
        return 0

    unreachable = []

    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        futures = {
            pool.submit(fetch_one, rom, titles.get(rom, ""), args.dir, kinds, unreachable, exact): rom
            for rom in pending
        }
        # As they land, not in the order asked: one slow server round trip
        # should not hold back every tile queued behind it.
        for future in as_completed(futures):
            rom = futures[future]
            try:
                path = future.result()
            except Exception:  # a failed download is a missing tile, never a crash
                path = ""
            print("%s\t%s" % (rom, path), flush=True)

    # Silence here used to be indistinguishable from success: an install that
    # fetched nothing because the machine was offline said so nowhere at all.
    if unreachable:
        print(
            "arcade-artwork: %d of %d could not reach %s, nothing recorded; "
            "they are tried again next time. First: %s"
            % (len(unreachable), len(pending), BASE_URL, unreachable[0]),
            file=sys.stderr,
        )

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
